# goto-agent@.service — one root-owned ssh-agent per role
#
# Why: OpenSSH's sshkey_perm_ok() fatally rejects reading a private key whose
# owner UID differs from the calling (non-root) process UID, so GoTo running
# as a regular user cannot use -i on root-owned role keys. A root-owned agent
# holding the role key, exposed through a group-accessible socket, sidesteps
# that check. Access to the sockets is limited to the "goto" group; the real
# enforcement boundary remains the ForceCommand (users never get a shell).
#
# Enable one instance per role credential:
#   systemctl enable --now goto-agent@marketing goto-agent@marketing-operator ...
[Unit]
Description=GoTo role ssh-agent for %i
After=network.target

[Service]
Type=simple
RuntimeDirectory=goto
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/ssh-agent -D -a /run/goto/agent-%i.sock
ExecStartPost=/usr/local/sbin/goto-agent-load %i
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
