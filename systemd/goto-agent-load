#!/bin/bash
# goto-agent-load — load a role key (and its certificate, if present) into the
# per-role agent and open the socket to the goto group.
# Invoked by goto-agent@.service as ExecStartPost.
set -euo pipefail

ROLE="$1"
SOCK="/run/goto/agent-${ROLE}.sock"
KEY="/etc/goto/keys/${ROLE}"

# The agent daemonizes the socket asynchronously — wait for it (max 5 s)
for _ in $(seq 1 50); do
  [[ -S "$SOCK" ]] && break
  sleep 0.1
done
[[ -S "$SOCK" ]] || { echo "goto-agent-load: socket $SOCK never appeared" >&2; exit 1; }

[[ -f "$KEY" ]] || { echo "goto-agent-load: role key $KEY not found" >&2; exit 1; }

chgrp goto /run/goto
chmod 0750 /run/goto

# ssh-add also loads ${KEY}-cert.pub automatically if it exists
SSH_AUTH_SOCK="$SOCK" ssh-add "$KEY"

chown root:goto "$SOCK"
chmod 0660 "$SOCK"
